# Скопируйте в .env и подставьте свои значения, либо экспортируйте в shell.
# LLM — любой OpenAI-совместимый эндпоинт.

# Базовый URL API (обязательно). Примеры:
#   OpenAI      : https://api.openai.com/v1
#   DeepSeek    : https://api.deepseek.com/v1
#   Together.ai : https://api.together.xyz/v1
#   Groq        : https://api.groq.com/openai/v1
#   локальный   : http://localhost:8000/v1   (vLLM / Ollama /v1 / LM Studio)
LLM_BASE_URL=https://api.openai.com/v1

# Идентификатор модели (обязательно). Примеры: gpt-4o-mini, deepseek-chat,
# meta-llama/Llama-3.3-70B-Instruct-Turbo, llama-3.3-70b-versatile ...
LLM_MODEL=gpt-4o-mini

# Ключ API (обязательно).
LLM_API_KEY=sk-...

# Необязательные:
LLM_TEMPERATURE=0.0
RAG_TOP_K=4
